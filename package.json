{
  "name": "l1-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "bash dev/db-up.sh",
    "db:ssh:up": "docker compose -f dev/docker-compose.yml --profile ssh up -d --wait --build sshd",
    "db:down": "docker compose -f dev/docker-compose.yml --profile mssql --profile ssh down -v",
    "dev": "vite",
    "tauri": "tauri",
    "bridge": "concurrently -k -n bridge,vite -c cyan,magenta \"cargo run -q -p dev-bridge\" \"vite\"",
    "build": "vite build",
    "test": "vitest run && node --test 'scripts/*.test.mjs' 'dev/perf/*.test.mjs'",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "screenshot": "cargo build -q -p dev-bridge -p l1-data -p engine && dev/screenshot.sh",
    "bindings": "UPDATE_BINDINGS=1 cargo test -q -p l1-data export_bindings_up_to_date",
    "icons": "dev/icons.sh",
    "self-check": "cargo build -q -p l1-data && L1_DATA_SELF_CHECK=1 L1_DATA_SECRET_STORE=memory L1_DATA_DATA_DIR=\"$(mktemp -d)\" ./target/debug/l1-data"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-context-menu": "^2.4.0",
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-dropdown-menu": "^2.2.0",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@tanstack/react-virtual": "^3.14.15",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.4",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
